# Copy to keystore.properties (gitignored) and fill in your real values.
# storeFile is resolved relative to the project root.
storeFile=release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD

# Generate a keystore locally:
#   keytool -genkeypair -v -keystore release.keystore -alias YOUR_KEY_ALIAS \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep release.keystore and keystore.properties OUT of git and back them up
# safely - losing the upload key breaks updates for existing installs.
